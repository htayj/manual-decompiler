#!/usr/bin/env bash
# Minimal Docker CLI compatibility layer for Surya's vLLM launcher.
# It deliberately supports only the commands Surya uses and translates NVIDIA
# Docker flags into rootless Podman CDI devices.

set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd)"
readonly LOCK_FILE="$REPO_ROOT/containers/images.lock.json"
readonly PODMAN_BIN="${LISPMDOC_PODMAN_BIN:-/usr/bin/podman}"

if [[ ! -x "$PODMAN_BIN" ]]; then
  echo "lispmdoc podman shim: podman not found at $PODMAN_BIN" >&2
  exit 127
fi

locked_image() {
  jq -er --arg name "$1" '.images[$name].reference' "$LOCK_FILE"
}

translate_image() {
  case "$1" in
    vllm/vllm-openai:*|docker.io/vllm/vllm-openai:*)
      locked_image surya-vllm
      ;;
    *)
      printf '%s\n' "$1"
      ;;
  esac
}

command_name="${1:-}"
if [[ -z "$command_name" ]]; then
  exec "$PODMAN_BIN"
fi
shift

case "$command_name" in
  run)
    translated=()
    while (($#)); do
      case "$1" in
        --runtime)
          shift
          (($#)) && shift
          ;;
        --runtime=*)
          shift
          ;;
        --gpus)
          shift
          gpu_request="${1:-all}"
          (($#)) && shift
          gpu_request="${gpu_request#device=}"
          translated+=(--device "nvidia.com/gpu=$gpu_request")
          ;;
        --gpus=*)
          gpu_request="${1#--gpus=}"
          gpu_request="${gpu_request#device=}"
          translated+=(--device "nvidia.com/gpu=$gpu_request")
          shift
          ;;
        vllm/vllm-openai:*|docker.io/vllm/vllm-openai:*)
          translated+=("$(translate_image "$1")")
          shift
          ;;
        *)
          translated+=("$1")
          shift
          ;;
      esac
    done
    exec "$PODMAN_BIN" run "${translated[@]}"
    ;;
  logs|stop|rm|ps|inspect|images|pull|version|info)
    exec "$PODMAN_BIN" "$command_name" "$@"
    ;;
  *)
    echo "lispmdoc podman shim: unsupported Docker command: $command_name" >&2
    exit 64
    ;;
esac
