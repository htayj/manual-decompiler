#!/usr/bin/env bash

set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd)"
readonly PODMAN_BIN="${LISPMDOC_PODMAN_BIN:-$(command -v podman)}"
readonly IMAGE="localhost/lispmdoc-paddleocr:3.7.0-cu126"
readonly MODEL_ROOT="${LISPMDOC_MODEL_ROOT:-$REPO_ROOT/work/models}"

mkdir -p "$MODEL_ROOT/paddleocr"

exec "$PODMAN_BIN" run --rm \
  --device nvidia.com/gpu=all \
  --volume "$REPO_ROOT:/work:ro" \
  --volume "$REPO_ROOT/work:/work/work:rw" \
  --volume "$MODEL_ROOT/paddleocr:/root/.paddlex:rw" \
  --workdir /work \
  "$IMAGE" "$@"
