{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lispmdoc.org/schemas/lmdoc/v1/document.schema.json",
  "title": "LMDOC v1 streamable document records",
  "oneOf": [
    {"$ref": "#/$defs/pageRecord"},
    {"$ref": "#/$defs/structureRecord"},
    {"$ref": "#/$defs/stylesRecord"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*-[0-9a-f]{12,64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "micropoint": {"type": "integer", "description": "Integer 1/1000 PDF point in a top-left-origin canonical page."},
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x0", "y0", "x1", "y1"],
      "properties": {"x0": {"$ref": "#/$defs/micropoint"}, "y0": {"$ref": "#/$defs/micropoint"}, "x1": {"$ref": "#/$defs/micropoint"}, "y1": {"$ref": "#/$defs/micropoint"}},
      "allOf": [
        {"$comment": "JSON Schema cannot portably compare sibling integers; model validation enforces x0 < x1 and y0 < y1. Boxes are half-open [x0,y0,x1,y1]."}
      ]
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "not": {"const": 0}}}
    },
    "affineTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b", "c", "d", "e", "f"],
      "properties": {"a": {"$ref": "#/$defs/rational"}, "b": {"$ref": "#/$defs/rational"}, "c": {"$ref": "#/$defs/rational"}, "d": {"$ref": "#/$defs/rational"}, "e": {"$ref": "#/$defs/rational"}, "f": {"$ref": "#/$defs/rational"}},
      "$comment": "The model additionally rejects singular matrices. Coefficients map source coordinates to canonical integer micropoints exactly."
    },
    "sceneObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "box", "payload"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["text", "text-block", "line", "span", "token", "glyph", "group", "clip-path", "rule", "shape", "path", "raster", "link", "annotation"]},
        "box": {"$ref": "#/$defs/box"},
        "style_id": {"$ref": "#/$defs/id"},
        "payload": {"type": "object"},
        "z_index": {"type": "integer"},
        "opacity_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true}
      }
    },
    "pageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_version", "id", "sequence", "source_page_index", "page_box", "page_class", "source_pdf_to_canonical", "render_pixels_to_canonical", "source_page_sha256", "objects", "reading_order"],
      "properties": {
        "format_version": {"const": "1.0"},
        "id": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 1},
        "source_page_index": {"type": "integer", "minimum": 0},
        "page_box": {"$ref": "#/$defs/box"},
        "page_class": {"enum": ["born-digital", "hybrid", "scan-bilevel", "scan-gray", "scan-color", "schematic", "photo-or-illustration-dominant", "ambiguous"]},
        "source_pdf_to_canonical": {"$ref": "#/$defs/affineTransform"},
        "render_pixels_to_canonical": {"$ref": "#/$defs/affineTransform"},
        "source_page_sha256": {"$ref": "#/$defs/sha256", "description": "Deprecated Phase 1 synthetic page digest; do not use as durable identity."},
        "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
        "source_render_sha256": {"$ref": "#/$defs/sha256"},
        "page_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "objects": {"type": "array", "items": {"$ref": "#/$defs/sceneObject"}, "uniqueItems": true},
        "reading_order": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "reading_edges": {"type": "array", "items": {"type": "object", "required": ["source_id", "target_id"], "properties": {"source_id": {"$ref": "#/$defs/id"}, "target_id": {"$ref": "#/$defs/id"}, "relation": {"type": "string"}}, "additionalProperties": true}}
      }
    },
    "structureNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "child_ids", "region_ids", "properties"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "minLength": 1},
        "child_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "region_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "text": {"type": "string"},
        "properties": {"type": "object"}
      }
    },
    "structureRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_version", "document_id", "root_id", "nodes"],
      "properties": {
        "format_version": {"const": "1.0"},
        "document_id": {"$ref": "#/$defs/id"},
        "root_id": {"$ref": "#/$defs/id"},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/structureNode"}, "uniqueItems": true}
      }
    },
    "styleToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "family", "size", "weight", "slant", "color", "tracking"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "size": {"$ref": "#/$defs/micropoint", "minimum": 1},
        "weight": {"type": "integer", "minimum": 1, "maximum": 1000},
        "slant": {"enum": ["normal", "italic", "oblique"]},
        "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "tracking": {"$ref": "#/$defs/micropoint"},
        "leading": {"$ref": "#/$defs/micropoint", "minimum": 1}
      }
    },
    "stylesRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_version", "document_id", "tokens"],
      "properties": {
        "format_version": {"const": "1.0"},
        "document_id": {"$ref": "#/$defs/id"},
        "tokens": {"type": "array", "items": {"$ref": "#/$defs/styleToken"}, "uniqueItems": true}
      }
    }
  }
}
