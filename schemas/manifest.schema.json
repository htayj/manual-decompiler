{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lispmdoc.org/schemas/lmdoc/v1/manifest.schema.json",
  "title": "LMDOC v1 manifest",
  "type": "object",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*-[0-9a-f]{12,64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "required": ["format_version", "document_id", "source", "pages", "profile", "configuration_sha256", "tools", "rights_notes", "conformance_level", "known_limitations"],
  "properties": {
    "format_version": {"const": "1.0"},
    "document_id": {"$ref": "#/$defs/id"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_size"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_size": {"type": "integer", "minimum": 1},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1, "not": {"pattern": "^/"}}, "uniqueItems": true}
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sequence", "path", "source_page_index"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "sequence": {"type": "integer", "minimum": 1},
          "path": {"type": "string", "pattern": "^pages/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"},
          "source_page_index": {"type": "integer", "minimum": 0}
        }
      }
    },
    "profile": {"type": "string", "minLength": 1},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "configuration_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "rights_notes": {"type": "array", "items": {"type": "string"}},
    "conformance_level": {"enum": ["replacement-ready", "review-required", "facsimile-required", "size-non-goal"]},
    "known_limitations": {"type": "array", "items": {"type": "string"}}
  }
}
