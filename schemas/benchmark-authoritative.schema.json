{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lispmdoc.org/schemas/benchmark-authoritative.schema.json",
  "title": "LMDOC authoritative typesetter-source truth package",
  "type": "object",
  "required": [
    "version",
    "queue_page",
    "queue_binding",
    "provenance",
    "mapping_evidence",
    "regions",
    "review_evidence"
  ],
  "properties": {
    "version": {"const": "lispmdoc-authoritative-typesetter-truth-1"},
    "queue_page": {"$ref": "#/$defs/queuePage"},
    "queue_binding": {"$ref": "#/$defs/queueBinding"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "mapping_evidence": {"$ref": "#/$defs/mappingEvidence"},
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/region"}
    },
    "review_evidence": {
      "oneOf": [{"$ref": "#/$defs/reviewEvidence"}, {"type": "null"}]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "expectedRun": {
      "type": ["object", "null"],
      "required": [
        "engine",
        "engine_version",
        "model",
        "model_version",
        "tool",
        "tool_version"
      ],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "queuePage": {
      "type": "object",
      "required": [
        "source_sha256",
        "source_page_index",
        "render_sha256",
        "page_class",
        "tags",
        "inventory_region_ids",
        "expected_run"
      ],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_page_index": {"type": "integer", "minimum": 0},
        "render_sha256": {"$ref": "#/$defs/sha256"},
        "page_class": {"type": "string", "minLength": 1},
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "inventory_region_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_run": {"$ref": "#/$defs/expectedRun"}
      },
      "additionalProperties": false
    },
    "queueBinding": {
      "type": "object",
      "required": [
        "source_sha256",
        "source_page_index",
        "render_sha256",
        "queue_page_sha256"
      ],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_page_index": {"type": "integer", "minimum": 0},
        "render_sha256": {"$ref": "#/$defs/sha256"},
        "queue_page_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "supportingFile": {
      "type": "object",
      "required": ["source_path", "sha256"],
      "properties": {
        "source_path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "textDerivation": {
      "type": "object",
      "required": [
        "method",
        "text_encoding",
        "converter_identity",
        "converter_sha256",
        "converted_text_sha256"
      ],
      "properties": {
        "method": {"enum": ["source-literal", "converted-text"]},
        "text_encoding": {"enum": ["utf-8", "ascii"]},
        "converter_identity": {"type": ["string", "null"]},
        "converter_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "converted_text_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"const": "source-literal"}}},
          "then": {
            "properties": {
              "converter_identity": {"type": "null"},
              "converter_sha256": {"type": "null"},
              "converted_text_sha256": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "converter_identity": {"type": "string", "minLength": 1},
              "converter_sha256": {"$ref": "#/$defs/sha256"},
              "converted_text_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_archive_sha256",
        "source_file_sha256",
        "edition_identity",
        "source_path",
        "normalization_rules",
        "text_derivation",
        "supporting_files"
      ],
      "properties": {
        "source_archive_sha256": {"$ref": "#/$defs/sha256"},
        "source_file_sha256": {"$ref": "#/$defs/sha256"},
        "edition_identity": {"type": "string", "minLength": 1},
        "source_path": {"$ref": "#/$defs/safePath"},
        "normalization_rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["none", "normalize-lf", "unicode-nfc", "strip-final-newline"]
          }
        },
        "text_derivation": {"$ref": "#/$defs/textDerivation"},
        "supporting_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/supportingFile"}
        }
      },
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "required": ["kind", "source_value", "scan_value", "match_method"],
      "properties": {
        "kind": {
          "enum": [
            "printed-page-number",
            "heading",
            "section-label",
            "source-footer",
            "scan-footer"
          ]
        },
        "source_value": {"type": "string", "minLength": 1},
        "scan_value": {"type": "string", "minLength": 1},
        "match_method": {"enum": ["literal", "normalized"]}
      },
      "additionalProperties": false
    },
    "mappingEvidence": {
      "type": "object",
      "required": ["anchors", "verification_state"],
      "properties": {
        "anchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/anchor"}
        },
        "verification_state": {
          "enum": ["verified", "human-mapping-review-required"]
        }
      },
      "additionalProperties": false
    },
    "reviewEvidence": {
      "type": "object",
      "required": ["reviewer", "project_sha256", "annotations_sha256"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "project_sha256": {"$ref": "#/$defs/sha256"},
        "annotations_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "point": {
      "type": "array",
      "prefixItems": [{"type": "integer"}, {"type": "integer"}],
      "minItems": 2,
      "maxItems": 2
    },
    "geometry": {
      "type": "object",
      "required": ["region_id", "polygon", "baseline", "reading_order", "semantic_type"],
      "properties": {
        "region_id": {"type": "string", "minLength": 1},
        "polygon": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/point"}
        },
        "baseline": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/point"}
        },
        "reading_order": {"type": "integer", "minimum": 0},
        "semantic_type": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "sourceSpan": {
      "type": "object",
      "required": ["start_line", "end_line"],
      "properties": {
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "required": [
        "geometry",
        "literal_text",
        "line_breaks",
        "kind",
        "source_span",
        "required",
        "layout_verification_state"
      ],
      "properties": {
        "geometry": {"$ref": "#/$defs/geometry"},
        "literal_text": {"type": "string"},
        "line_breaks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "kind": {"type": "string", "minLength": 1},
        "source_span": {"$ref": "#/$defs/sourceSpan"},
        "required": {"type": "boolean"},
        "layout_verification_state": {
          "enum": ["verified", "human-review-required", "discrepancy"]
        }
      },
      "additionalProperties": false
    }
  }
}
