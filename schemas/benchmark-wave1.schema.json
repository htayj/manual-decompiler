{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lispmdoc.org/schemas/benchmark-wave1.schema.json",
  "title": "LMDOC Wave 1 benchmark queue",
  "type": "object",
  "required": ["version", "pages"],
  "properties": {
    "version": {"const": "lispmdoc-benchmark-wave1"},
    "note": {"type": "string"},
    "pages": {
      "type": "array",
      "items": {"$ref": "#/$defs/page"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expectedRun": {
      "type": "object",
      "required": [
        "engine",
        "engine_version",
        "model",
        "model_version",
        "tool",
        "tool_version"
      ],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": [
        "source_sha256",
        "source_page_index",
        "render_sha256",
        "page_class",
        "tags"
      ],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_page_index": {"type": "integer", "minimum": 0},
        "render_sha256": {"$ref": "#/$defs/sha256"},
        "page_class": {"type": "string", "minLength": 1},
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "inventory_region_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_run": {
          "oneOf": [
            {"$ref": "#/$defs/expectedRun"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
