#!/usr/bin/env python3
"""Verify the local Wave-2 representative inventory without rendering or OCR."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path

from lispmdoc.benchmark.wave2 import Wave2InventoryError, load_inventory, verify_inventory


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path.cwd())
    parser.add_argument(
        "--inventory",
        default="config/benchmarks/wave2-representative-candidates.json",
        help="contained inventory path relative to --root",
    )
    args = parser.parse_args()
    if args.root.is_symlink():
        parser.error("inventory root must be a non-symlink directory")
    root = args.root.resolve()
    try:
        inventory, inventory_bytes = load_inventory(root, args.inventory)
        report = verify_inventory(root, inventory)
    except Wave2InventoryError as error:
        parser.error(str(error))
    report["inventory_sha256"] = hashlib.sha256(inventory_bytes).hexdigest()
    print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
