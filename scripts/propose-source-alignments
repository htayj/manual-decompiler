#!/usr/bin/env python3
"""Propose recovered-source mappings for OCR helper text from rendered pages."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import subprocess
from html.parser import HTMLParser
from pathlib import Path

from lispmdoc.benchmark import (
    OcrRegionText,
    RecoveredSourceIndex,
    align_ocr_regions_to_source,
    parse_manual_vars,
)

_PAGE_NAME = re.compile(r"p(?P<page>[0-9]{6})\.txt")


class _TextExtractor(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.parts: list[str] = []

    def handle_data(self, data: str) -> None:
        self.parts.append(data)


def _html_text(value: str) -> str:
    parser = _TextExtractor()
    parser.feed(value)
    return " ".join("".join(parser.parts).split())


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _write_new(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    with path.open("x", encoding="utf-8") as stream:
        stream.write(payload + "\n")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--render-manifest", type=Path, required=True)
    parser.add_argument("--ocr-directory", type=Path, required=True)
    parser.add_argument("--source-directory", type=Path, required=True)
    parser.add_argument("--manual-vars", type=Path, required=True)
    parser.add_argument("--layout-results", type=Path)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()

    manifest = json.loads(args.render_manifest.read_text(encoding="utf-8"))
    rendered_pages = {int(page["page_number"]): page for page in manifest["pages"]}
    variables = parse_manual_vars(args.manual_vars.read_text(encoding="latin-1"))
    source_paths = tuple(
        path
        for path in sorted(args.source_directory.iterdir())
        if path.is_file() and path != args.manual_vars and not path.name.startswith("_")
    )
    sources = {path.name: path.read_text(encoding="latin-1") for path in source_paths}
    index = RecoveredSourceIndex(sources, variables)
    layout_results = (
        json.loads(args.layout_results.read_text(encoding="utf-8")) if args.layout_results else None
    )
    alignments: list[dict[str, object]] = []
    for ocr_path in sorted(args.ocr_directory.glob("p??????.txt")):
        match = _PAGE_NAME.fullmatch(ocr_path.name)
        assert match is not None
        page_number = int(match.group("page"))
        rendered = rendered_pages.get(page_number)
        if rendered is None:
            raise ValueError(f"OCR page {page_number} is absent from the render manifest")
        alignment = index.align(ocr_path.read_text(encoding="utf-8"))
        source_path = args.source_directory / alignment.source_path
        region_records: list[dict[str, object]] = []
        if layout_results is not None:
            page_key = f"p{page_number:06}"
            raw_page = layout_results.get(page_key)
            if not isinstance(raw_page, list) or len(raw_page) != 1:
                raise ValueError(f"layout results lack one output for {page_key}")
            raw_blocks = sorted(raw_page[0]["blocks"], key=lambda block: block["reading_order"])
            content_blocks = [
                block for block in raw_blocks if block["label"] not in {"PageHeader", "PageFooter"}
            ]
            region_texts = tuple(
                OcrRegionText(f"block-{index:03d}", _html_text(block["html"]))
                for index, block in enumerate(content_blocks, start=1)
            )
            region_alignments = align_ocr_regions_to_source(
                region_texts,
                sources[alignment.source_path],
                variables,
                approximate_start_line=alignment.start_line,
                approximate_end_line=alignment.end_line,
            )
            region_records = [
                {
                    "alignment": region_alignment.to_dict(),
                    "alternate_source_alignment": (
                        alternate.to_dict()
                        if region_alignment.coverage_milli < 500
                        and len(region_text.text.split()) >= 10
                        and (alternate := index.align(region_text.text)).coverage_milli
                        > region_alignment.coverage_milli
                        else None
                    ),
                    "bbox": block["bbox"],
                    "layout_label": block["label"],
                    "ocr_text": region_text.text,
                    "reading_order": block["reading_order"],
                }
                for block, region_text, region_alignment in zip(
                    content_blocks, region_texts, region_alignments, strict=True
                )
            ]
        alignments.append(
            {
                "alignment": alignment.to_dict(),
                "ocr_artifact": {
                    "path": ocr_path.as_posix(),
                    "sha256": _sha256(ocr_path),
                },
                "page_number": page_number,
                "render_sha256": rendered["image"]["sha256"],
                "regions": region_records,
                "source_sha256": _sha256(source_path),
            }
        )
    if not alignments:
        raise ValueError("OCR directory contains no pNNNNNN.txt artifacts")
    _write_new(
        args.output,
        {
            "alignments": alignments,
            "format_version": "lispmdoc-source-alignment-proposals-1",
            "ground_truth_status": "not-ground-truth",
            "manual_vars_sha256": _sha256(args.manual_vars),
            "layout_results_sha256": (
                _sha256(args.layout_results) if args.layout_results else None
            ),
            "ocr_engine": {
                "name": "tesseract",
                "version": subprocess.run(
                    ["tesseract", "--version"], check=True, capture_output=True, text=True
                ).stdout.splitlines()[0],
            },
            "render_manifest_sha256": _sha256(args.render_manifest),
            "source_pdf_sha256": manifest["source"]["sha256"],
        },
    )
    print(args.output.resolve())
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
