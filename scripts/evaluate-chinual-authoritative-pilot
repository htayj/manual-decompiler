#!/usr/bin/env python3
"""Produce a provisional, source-grounded text report for the Chinual pilot."""

from __future__ import annotations

import argparse
import hashlib
import json
from html.parser import HTMLParser
from pathlib import Path
from typing import Any

from lispmdoc.benchmark import (
    AuthoritativeTruthPackage,
    SpatialTextLine,
    evaluate_spatial_lines,
)


class _HTMLText(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.parts: list[str] = []

    def handle_data(self, data: str) -> None:
        self.parts.append(data)


def _html_text(value: str) -> str:
    parser = _HTMLText()
    parser.feed(value)
    return "".join(parser.parts)


def _sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def _bbox(value: object) -> tuple[float, float, float, float]:
    if not isinstance(value, list) or len(value) != 4:
        raise ValueError("OCR bbox must contain four coordinates")
    coordinates = tuple(float(item) for item in value)
    return coordinates  # type: ignore[return-value]


def _poly_bbox(value: object) -> tuple[float, float, float, float]:
    if not isinstance(value, list) or len(value) < 3:
        raise ValueError("OCR polygon must contain at least three points")
    points = [tuple(float(coordinate) for coordinate in point) for point in value]
    if any(len(point) != 2 for point in points):
        raise ValueError("OCR polygon points must contain two coordinates")
    xs = [point[0] for point in points]
    ys = [point[1] for point in points]
    return min(xs), min(ys), max(xs), max(ys)


def _surya_lines(value: Any) -> tuple[SpatialTextLine, ...]:
    blocks = value["p000100"][0]["blocks"]
    return tuple(
        SpatialTextLine(_html_text(str(block["html"])), _bbox(block["bbox"]))
        for block in blocks
    )


def _paddle_lines(value: Any) -> tuple[SpatialTextLine, ...]:
    result = value["res"]
    texts = result["rec_texts"]
    polygons = result["dt_polys"]
    if len(texts) != len(polygons):
        raise ValueError("Paddle text and polygon inventories differ")
    return tuple(
        SpatialTextLine(str(text), _poly_bbox(polygon))
        for text, polygon in zip(texts, polygons, strict=True)
    )


def _engine_report(
    package: AuthoritativeTruthPackage,
    lines: tuple[SpatialTextLine, ...],
) -> dict[str, object]:
    evaluation = evaluate_spatial_lines(package.regions, lines)
    return {
        "metrics": evaluation.report.to_dict(),
        "predictions": dict(sorted(evaluation.predictions.items())),
        "unassigned_lines": [
            {"bbox": list(line.bbox), "text": line.text}
            for line in evaluation.unassigned_lines
        ],
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--project-root", type=Path, default=Path.cwd())
    parser.add_argument(
        "--review-dir",
        type=Path,
        default=Path("work/benchmark-pilot/authoritative-review-r5"),
    )
    parser.add_argument(
        "--output",
        type=Path,
        help="default: ocr-quality.json inside --review-dir",
    )
    args = parser.parse_args()
    root = args.project_root.resolve()
    review = args.review_dir if args.review_dir.is_absolute() else root / args.review_dir
    package_path = review / "reviewed-truth-package.json"
    annotations_path = review / "review-project.annotations.json"
    raw_manifest_path = root / "work/benchmark-pilot/raw-artifacts.json"
    package = AuthoritativeTruthPackage.from_json(package_path.read_text(encoding="utf-8"))
    if package.review_evidence is None or not package.mapping_evidence.ready:
        raise ValueError("pilot needs saved review evidence and accepted page mapping")

    raw_manifest = json.loads(raw_manifest_path.read_text(encoding="utf-8"))
    output_records = {record["engine"]: record for record in raw_manifest["outputs"]}
    paths = {
        engine: root / "work/benchmark-pilot" / record["path"]
        for engine, record in output_records.items()
    }
    for engine, path in paths.items():
        if _sha256(path) != output_records[engine]["sha256"]:
            raise ValueError(f"{engine} raw OCR digest changed")

    surya_value = json.loads(paths["surya"].read_text(encoding="utf-8"))
    paddle_value = json.loads(paths["paddleocr"].read_text(encoding="utf-8"))
    report = {
        "engines": {
            "paddleocr": {
                **output_records["paddleocr"],
                **_engine_report(package, _paddle_lines(paddle_value)),
            },
            "surya": {
                **output_records["surya"],
                **_engine_report(package, _surya_lines(surya_value)),
            },
        },
        "format_version": "lispmdoc-authoritative-pilot-evaluation-1",
        "ground_truth": {
            "annotations_sha256": _sha256(annotations_path),
            "package_sha256": _sha256(package_path),
            "page_id": package.queue_page.id,
            "review_disposition": package.status().disposition,
            "text_profile": (
                "collapse Unicode whitespace for prose/definitions/headings; preserve code"
            ),
        },
        "selection_disposition": "provisional-text-only",
        "selection_reason": (
            "page mapping is accepted, but reviewed typography/layout discrepancies remain"
        ),
    }
    output = args.output or review / "ocr-quality.json"
    if not output.is_absolute():
        output = root / output
    output.parent.mkdir(parents=True, exist_ok=True)
    with output.open("x", encoding="utf-8") as stream:
        json.dump(report, stream, ensure_ascii=False, indent=2, sort_keys=True)
        stream.write("\n")
    print(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
