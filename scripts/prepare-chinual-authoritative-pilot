#!/usr/bin/env python3
"""Prepare the ignored Chinual page-100 source-mapping review pilot."""

from __future__ import annotations

import argparse
import hashlib
import json
import shutil
import subprocess
from collections.abc import Mapping, Sequence
from html.parser import HTMLParser
from pathlib import Path

from lispmdoc.benchmark import (
    AUTHORITATIVE_TRUTH_VERSION,
    AuthoritativeRegionTruth,
    AuthoritativeTruthPackage,
    MappingAnchor,
    MappingEvidence,
    QueuePage,
    QueuePageBinding,
    RegionGeometry,
    SemanticTextSpan,
    SourceSpan,
    SupportingSourceFile,
    TextDerivation,
    TypesetterSourceProvenance,
    extract_bolio,
    parse_manual_vars,
    render_reference_artifact,
    semantic_spans,
)
from lispmdoc.benchmark.workspace import expected_run_from_dict
from lispmdoc.typography import (
    NativeLayoutConfig,
    NativeRegionLayout,
    PhysicalTextStyle,
    compose_native_svg,
    layout_native_region,
)

SOURCE_PDF_SHA256 = "123ceb361b0c84864425fc7eee319afc9891a7a68e417f93386f8172334a6e85"
RENDER_SHA256 = "54cb0a866ecb74d6594ab834b83865221df1feb1cc51fbcfb2c4b5f568f7f502"
ARCHIVE_SHA256 = "1bf917d545a854d3e04c6c778bbb8788b8d42b9c4fc41e9b39b6534014fe3b67"
SOURCE_SHA256 = "36352edeacc7213bbcf9037e4cadad7c068066b352d130450f2e7986b1a4216e"
VARS_SHA256 = "020d38f5d3b990444768c20adb36cc676188057f3faee23a8030fb7dbad4c4ba"
PAGE_WIDTH = 2550
PAGE_HEIGHT = 3300
SERIF_FONT = "Liberation Serif"
SANS_FONT = "Liberation Sans"
MONO_FONT = "Liberation Mono"
FOOTER_SOURCE = "MC:LMMAN;FD.SYM 70"


_BASE_FONT_SIZE = {"body": 44.0, "code": 40.0, "function": 46.0, "section": 53.0}
_LINE_HEIGHT = {"body": 1.20, "code": 1.18, "function": 1.16, "section": 1.14}
_OPTICAL_LEFT_INSET_FACTOR = 0.13

InlineRun = SemanticTextSpan
RegionLayout = NativeRegionLayout

_CHINUAL_LAYOUT = NativeLayoutConfig(
    default_style=PhysicalTextStyle(SERIF_FONT),
    semantic_styles={
        "font-2-italic": PhysicalTextStyle(SERIF_FONT, "italic"),
        "font-3-inline-lisp": PhysicalTextStyle(SANS_FONT),
        "definition-name": PhysicalTextStyle(MONO_FONT, weight=700),
        "definition-argument": PhysicalTextStyle(SERIF_FONT, "italic"),
        "section-title": PhysicalTextStyle(SERIF_FONT, weight=700),
    },
    block_styles={"code": PhysicalTextStyle(MONO_FONT)},
    base_font_sizes=_BASE_FONT_SIZE,
    line_heights=_LINE_HEIGHT,
    optical_left_inset_factor=_OPTICAL_LEFT_INSET_FACTOR,
)


class _TextExtractor(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.parts: list[str] = []

    def handle_data(self, data: str) -> None:
        self.parts.append(data)


def _html_text(value: str) -> str:
    parser = _TextExtractor()
    parser.feed(value)
    return " ".join("".join(parser.parts).split())


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _font_identity(family: str) -> dict[str, str]:
    path_text = subprocess.run(
        ["fc-match", "-f", "%{file}\n", family],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.splitlines()
    if not path_text:
        raise ValueError(f"Fontconfig did not resolve required family {family!r}")
    path = Path(path_text[0])
    return {"family": family, "path": str(path), "sha256": _sha256(path)}


def _tool_version(command: Sequence[str]) -> str:
    return subprocess.run(command, check=True, capture_output=True, text=True).stdout.strip()


def _span_records(runs: Sequence[InlineRun]) -> list[dict[str, object]]:
    records: list[dict[str, object]] = []
    offset = 0
    for run in runs:
        end = offset + len(run.text)
        records.append(
            {
                "evidence": run.evidence,
                "semantic_role": run.style,
                "text_end": end,
                "text_start": offset,
            }
        )
        offset = end
    return records


def _json_bytes(value: object) -> bytes:
    return (
        json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n"
    ).encode("utf-8")


def _write_new(path: Path, payload: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as stream:
        stream.write(payload)


def _bbox(block: dict[str, object]) -> tuple[int, int, int, int]:
    raw = block["bbox"]
    if not isinstance(raw, list) or len(raw) != 4:
        raise ValueError("Surya block lacks a four-coordinate bbox")
    return tuple(round(float(value)) for value in raw)  # type: ignore[return-value]


def _semantic_type(kind: str) -> str:
    return {"function": "definition", "section": "section", "body": "prose", "code": "code"}[kind]


def semantic_runs(
    *,
    kind: str,
    reference_text: str,
    raw_lines: Sequence[str],
    variables: Mapping[str, str],
) -> tuple[InlineRun, ...]:
    return semantic_spans(
        kind=kind,
        reference_text=reference_text,
        raw_lines=raw_lines,
        variables=variables,
    )


def _physical_style(style: str, kind: str) -> tuple[str, str, int]:
    physical = _CHINUAL_LAYOUT.style_for(InlineRun("", style), kind)
    return physical.family, physical.slant, physical.weight


def layout_region(
    *,
    kind: str,
    runs: Sequence[InlineRun],
    bbox: tuple[int, int, int, int],
    paragraph_indent: bool,
) -> RegionLayout:
    return layout_native_region(
        kind=kind,
        spans=runs,
        bbox=bbox,
        first_line_indent=paragraph_indent,
        config=_CHINUAL_LAYOUT,
    )


def _svg(layouts: Sequence[RegionLayout]) -> bytes:
    return compose_native_svg(layouts, width=PAGE_WIDTH, height=PAGE_HEIGHT, background="#fffdf8")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--project-root", type=Path, default=Path.cwd())
    parser.add_argument(
        "--output", type=Path, default=Path("work/benchmark-pilot/authoritative-review-r11")
    )
    args = parser.parse_args()
    root = args.project_root.resolve()
    output = (root / args.output).resolve() if not args.output.is_absolute() else args.output
    if output.exists():
        raise FileExistsError(f"refusing to overwrite pilot output: {output}")

    recovered = root / "source-material/reference-transcriptions/unlambda"
    archive = recovered / "lmman.tar.gz"
    lmman = recovered / "extracted/lmman"
    source = lmman / "orig4ed/fd_sym.70"
    variables = lmman / "orig4ed/manual.vars"
    scan = next((root / "work/benchmark-pilot" / SOURCE_PDF_SHA256).glob("*/pages/p000100.png"))
    surya = root / "work/benchmark-pilot/surya/p000100/results.json"
    old_queue = json.loads((root / "work/benchmark-pilot/queue-pilot.json").read_text())

    expected = {
        archive: ARCHIVE_SHA256,
        source: SOURCE_SHA256,
        variables: VARS_SHA256,
        scan: RENDER_SHA256,
    }
    for path, digest in expected.items():
        if _sha256(path) != digest:
            raise ValueError(f"pilot input digest changed: {path}")

    source_text = source.read_text(encoding="latin-1")
    variables_text = variables.read_text(encoding="latin-1")
    extraction = extract_bolio(
        source_text,
        variables_text,
        start_line=126,
        end_line=180,
    )
    if extraction.issues:
        raise ValueError("Bolio extraction has unresolved issues")
    reference = render_reference_artifact(extraction)
    source_lines = source_text.splitlines()
    source_variables = parse_manual_vars(variables_text)

    raw_surya = json.loads(surya.read_text(encoding="utf-8"))
    blocks = raw_surya["p000100"][0]["blocks"]
    content_blocks = [block for block in blocks if 3 <= int(block["reading_order"]) <= 17]
    if len(content_blocks) != len(reference.regions):
        raise ValueError("source blocks no longer align one-to-one with Surya content blocks")

    reference_runs = []
    for reference_region in reference.regions:
        raw_lines = source_lines[
            reference_region.bolio_start_line - 1 : reference_region.bolio_end_line
        ]
        reference_runs.append(
            semantic_runs(
                kind=reference_region.kind,
                reference_text=reference_region.text,
                raw_lines=raw_lines,
                variables=source_variables,
            )
        )

    converter_files = [
        root / "src/lispmdoc/benchmark/bolio.py",
        root / "src/lispmdoc/benchmark/source_reference.py",
        root / "scripts/prepare-chinual-authoritative-pilot",
    ]
    font_identities = [_font_identity(family) for family in (SERIF_FONT, SANS_FONT, MONO_FONT)]
    converter_manifest = _json_bytes(
        {
            "format_version": "lispmdoc-bolio-reference-converter-2",
            "implementation_files": [
                {"path": path.relative_to(root).as_posix(), "sha256": _sha256(path)}
                for path in converter_files
            ],
            "native_layout": {
                "font_assets": font_identities,
                "pango_version": _tool_version(("pango-view", "--version")),
                "renderer": "one-pango-layout-per-region-to-cairo-svg-outlines",
            },
            "physical_style_mapping": {
                "body": {"family": SERIF_FONT, "evidence": "scan-matched-substitute"},
                "definition-argument": {
                    "family": SERIF_FONT,
                    "slant": "italic",
                    "evidence": "typesetter-guide-explicit",
                },
                "definition-name": {
                    "family": MONO_FONT,
                    "weight": 700,
                    "evidence": "typesetter-guide-function-name-font; r8-human-scan-classification",
                },
                "display-code": {
                    "family": MONO_FONT,
                    "evidence": "typesetter-guide-fixed-width; family-substitute",
                },
                "font-2-italic": {
                    "family": SERIF_FONT,
                    "slant": "italic",
                    "evidence": "source-selector-2-and-typesetter-guide",
                },
                "font-3-inline-lisp": {
                    "family": SANS_FONT,
                    "weight": 400,
                    "evidence": "r7-human-scan-classification; exact-artifact-unresolved",
                },
            },
            "regions": [
                {
                    "bolio_source_span": [
                        region.bolio_start_line,
                        region.bolio_end_line,
                    ],
                    "index": region.index,
                    "kind": region.kind,
                    "line_break_policy": region.line_break_policy,
                    "semantic_spans": _span_records(runs),
                }
                for region, runs in zip(reference.regions, reference_runs, strict=True)
            ],
            "source_line_span": [126, 180],
        }
    )
    converter_sha256 = hashlib.sha256(converter_manifest).hexdigest()

    prior_page = old_queue["pages"][0]
    region_ids = tuple(f"block-{index:03d}" for index in range(1, len(reference.regions) + 1))
    queue_page = QueuePage(
        SOURCE_PDF_SHA256,
        99,
        RENDER_SHA256,
        str(prior_page["page_class"]),
        tuple(prior_page["tags"]),
        region_ids,
        expected_run_from_dict(prior_page["expected_run"]),
    )
    truth_regions: list[AuthoritativeRegionTruth] = []
    review_regions: list[dict[str, object]] = []
    layouts: list[RegionLayout] = []
    for region_id, reference_region, runs, surya_block in zip(
        region_ids, reference.regions, reference_runs, content_blocks, strict=True
    ):
        x1, y1, x2, y2 = _bbox(surya_block)
        semantic = _semantic_type(reference_region.kind)
        breaks = tuple(
            index for index, character in enumerate(reference_region.text) if character == "\n"
        )
        truth_regions.append(
            AuthoritativeRegionTruth(
                RegionGeometry(
                    region_id,
                    ((x1, y1), (x2, y1), (x2, y2), (x1, y2)),
                    ((x1, y2), (x2, y2)),
                    reference_region.index,
                    semantic,
                ),
                reference_region.text,
                breaks,
                reference_region.kind,
                SourceSpan(
                    reference_region.source_span.start_line,
                    reference_region.source_span.end_line,
                ),
                layout_verification_state="human-review-required",
            )
        )
        paragraph_indent = semantic == "prose" and x1 <= round(PAGE_WIDTH * 0.13)
        layout = layout_region(
            kind=reference_region.kind,
            runs=runs,
            bbox=(x1, y1, x2, y2),
            paragraph_indent=paragraph_indent,
        )
        layouts.append(layout)
        normalized_reference_box = [
            x1 / PAGE_WIDTH,
            y1 / PAGE_HEIGHT,
            (x2 - x1) / PAGE_WIDTH,
            (y2 - y1) / PAGE_HEIGHT,
        ]
        generated_x1, generated_y1, generated_x2, generated_y2 = layout.generated_bbox
        normalized_generated_box = [
            generated_x1 / PAGE_WIDTH,
            generated_y1 / PAGE_HEIGHT,
            (generated_x2 - generated_x1) / PAGE_WIDTH,
            (generated_y2 - generated_y1) / PAGE_HEIGHT,
        ]
        review_regions.append(
            {
                "canonical_text": reference_region.text,
                "id": region_id,
                "kind": semantic,
                "label": reference_region.text.splitlines()[0][:80],
                "ocr_text": _html_text(str(surya_block["html"])),
                "reference_box": normalized_reference_box,
                "generated_box": normalized_generated_box,
                "source_text": reference_region.text,
            }
        )

    furniture_specs = (
        ("running-header-section", "The Property List", _bbox(blocks[0])),
        ("running-header-page", "88", _bbox(blocks[1])),
        ("running-header-title", "Lisp Machine Manual", _bbox(blocks[2])),
        ("running-footer-source", FOOTER_SOURCE, _bbox(blocks[18])),
        ("running-footer-date", "24-JUL-81", _bbox(blocks[19])),
    )
    furniture_records: list[dict[str, object]] = []
    for furniture_id, text, bbox in furniture_specs:
        furniture_layout = layout_region(
            kind="body",
            runs=(InlineRun(text, "body", "scan-derived-human-verified-running-matter"),),
            bbox=bbox,
            paragraph_indent=False,
        )
        layouts.append(furniture_layout)
        furniture_records.append(
            {
                "generated_bbox": list(furniture_layout.generated_bbox),
                "id": furniture_id,
                "provenance": "scan-derived-human-verified-running-matter",
                "reference_bbox": list(bbox),
                "text": text,
            }
        )

    package = AuthoritativeTruthPackage(
        AUTHORITATIVE_TRUTH_VERSION,
        queue_page,
        QueuePageBinding.from_queue_page(queue_page),
        TypesetterSourceProvenance(
            ARCHIVE_SHA256,
            SOURCE_SHA256,
            "Lisp Machine Manual, fourth edition, July 1981",
            "lmman/orig4ed/fd_sym.70",
            ("strip-final-newline",),
            TextDerivation(
                "converted-text",
                "utf-8",
                "lispmdoc-bolio-reference-converter-2",
                converter_sha256,
                reference.sha256,
            ),
            (SupportingSourceFile("lmman/orig4ed/manual.vars", VARS_SHA256),),
        ),
        MappingEvidence(
            (
                MappingAnchor("printed-page-number", "88", "88"),
                MappingAnchor("heading", "The Property List", "The Property List"),
                MappingAnchor("source-footer", FOOTER_SOURCE, FOOTER_SOURCE),
            ),
            "human-mapping-review-required",
        ),
        tuple(truth_regions),
    )

    assets = output / "assets"
    assets.mkdir(parents=True)
    scan_copy = assets / "scan-p000100.png"
    shutil.copyfile(scan, scan_copy)
    replica = assets / "source-layout-p000100.svg"
    _write_new(replica, _svg(layouts))
    _write_new(output / "reference.txt", reference.bytes)
    _write_new(output / "converter-manifest.json", converter_manifest)
    _write_new(output / "truth-package.json", package.to_json().encode("utf-8"))
    _write_new(
        output / "queue.json",
        _json_bytes({"pages": [queue_page.to_dict()], "version": "lispmdoc-benchmark-wave1"}),
    )
    review_project = {
        "assets": {
            "replica-p000100": {
                "media_type": "image/svg+xml",
                "path": "assets/source-layout-p000100.svg",
                "sha256": _sha256(replica),
            },
            "scan-p000100": {
                "media_type": "image/png",
                "path": "assets/scan-p000100.png",
                "sha256": _sha256(scan_copy),
            },
        },
        "document_id": "chinual-4th-edition-page-100",
        "format_version": "1.0",
        "pages": [
            {
                "generated_asset_id": "replica-p000100",
                "id": queue_page.id,
                "label": "PDF page 100 · printed page 88 · FD.SYM 70",
                "reference_asset_id": "scan-p000100",
                "regions": review_regions,
            }
        ],
        "review_instructions": {
            "page": (
                "Accept only if the scan is printed page 88 and its footer identifies "
                f"{FOOTER_SOURCE}, and if the three running headers and two footer "
                "items are all present in the replica. This confirms mapping and running matter."
            ),
            "region": (
                "Accept only if wording, source-scoped typeface, paragraph reflow/indent, and "
                "the highlighted scan region agree. The same spelling may have different styles "
                "in different source contexts. Check that mixed-style words have ordinary spacing "
                "with neither gaps nor overlap. Use needs fix for any mismatch."
            ),
        },
        "running_matter": furniture_records,
        "title": "Chinual 4th edition · authoritative-source pilot",
    }
    _write_new(output / "review-project.json", _json_bytes(review_project))
    prior_annotations = (
        root / "work/benchmark-pilot/authoritative-review-r10/review-project.annotations.json"
    )
    prior_project = root / "work/benchmark-pilot/authoritative-review-r10/review-project.json"
    if prior_annotations.is_file() and prior_project.is_file():
        _write_new(
            output / "prior-review-feedback.json",
            _json_bytes(
                {
                    "annotations": json.loads(prior_annotations.read_text(encoding="utf-8")),
                    "prior_review_project_sha256": _sha256(prior_project),
                    "prior_review_revision": "r10",
                    "status": "retained-separately; do-not-apply-to-new-revision",
                }
            ),
        )
    _write_new(
        output / "material-paths.json",
        _json_bytes(
            {
                "converted_text": "reference.txt",
                "converter": "converter-manifest.json",
                "source_archive": str(archive),
                "source_file": str(source),
                "supporting": {"lmman/orig4ed/manual.vars": str(variables)},
            }
        ),
    )
    print(output / "review-project.json")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
