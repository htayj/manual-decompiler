#!/usr/bin/env python3
"""Prepare the ignored Chinual page-100 source-mapping review pilot."""

from __future__ import annotations

import argparse
import hashlib
import html
import json
import re
import shutil
import subprocess
import tempfile
from collections.abc import Mapping, Sequence
from dataclasses import dataclass
from html.parser import HTMLParser
from pathlib import Path

from lispmdoc.benchmark import (
    AUTHORITATIVE_TRUTH_VERSION,
    AuthoritativeRegionTruth,
    AuthoritativeTruthPackage,
    MappingAnchor,
    MappingEvidence,
    QueuePage,
    QueuePageBinding,
    RegionGeometry,
    SourceSpan,
    SupportingSourceFile,
    TextDerivation,
    TypesetterSourceProvenance,
    extract_bolio,
    parse_manual_vars,
    render_reference_artifact,
)
from lispmdoc.benchmark.workspace import expected_run_from_dict

SOURCE_PDF_SHA256 = "123ceb361b0c84864425fc7eee319afc9891a7a68e417f93386f8172334a6e85"
RENDER_SHA256 = "54cb0a866ecb74d6594ab834b83865221df1feb1cc51fbcfb2c4b5f568f7f502"
ARCHIVE_SHA256 = "1bf917d545a854d3e04c6c778bbb8788b8d42b9c4fc41e9b39b6534014fe3b67"
SOURCE_SHA256 = "36352edeacc7213bbcf9037e4cadad7c068066b352d130450f2e7986b1a4216e"
VARS_SHA256 = "020d38f5d3b990444768c20adb36cc676188057f3faee23a8030fb7dbad4c4ba"
PAGE_WIDTH = 2550
PAGE_HEIGHT = 3300
SERIF_FONT = "Liberation Serif"
SANS_FONT = "Liberation Sans"
MONO_FONT = "Liberation Mono"


@dataclass(frozen=True, slots=True)
class InlineRun:
    """An exact source-scoped semantic span, before visual font matching."""

    text: str
    style: str = "body"
    evidence: str = "source-default-font-1"


@dataclass(frozen=True, slots=True)
class RegionLayout:
    svg_inner: str
    origin: tuple[float, float]
    font_size: float
    line_height: float
    line_count: int
    generated_bbox: tuple[float, float, float, float]
    spans: tuple[InlineRun, ...]
    font_runs: tuple[dict[str, object], ...]


# These names preserve the authoring semantics documented by _forma.33.  The
# physical scan match is deliberately separate: selector 3 currently maps to a
# regular sans face, not to a guessed CSS "bold" trait.
_ROLE_BY_SELECTOR = {"1": "body", "2": "font-2-italic", "3": "font-3-inline-lisp"}
_BASE_FONT_SIZE = {"body": 44.0, "code": 40.0, "function": 46.0, "section": 53.0}
_LINE_HEIGHT = {"body": 1.20, "code": 1.18, "function": 1.16, "section": 1.14}
_OPTICAL_LEFT_INSET_FACTOR = 0.13


class _TextExtractor(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.parts: list[str] = []

    def handle_data(self, data: str) -> None:
        self.parts.append(data)


def _html_text(value: str) -> str:
    parser = _TextExtractor()
    parser.feed(value)
    return " ".join("".join(parser.parts).split())


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _font_identity(family: str) -> dict[str, str]:
    path_text = subprocess.run(
        ["fc-match", "-f", "%{file}\n", family],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.splitlines()
    if not path_text:
        raise ValueError(f"Fontconfig did not resolve required family {family!r}")
    path = Path(path_text[0])
    return {"family": family, "path": str(path), "sha256": _sha256(path)}


def _tool_version(command: Sequence[str]) -> str:
    return subprocess.run(
        command, check=True, capture_output=True, text=True
    ).stdout.strip()


def _span_records(runs: Sequence[InlineRun]) -> list[dict[str, object]]:
    records: list[dict[str, object]] = []
    offset = 0
    for run in runs:
        end = offset + len(run.text)
        records.append(
            {
                "evidence": run.evidence,
                "semantic_role": run.style,
                "text_end": end,
                "text_start": offset,
            }
        )
        offset = end
    return records


def _json_bytes(value: object) -> bytes:
    return (
        json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n"
    ).encode("utf-8")


def _write_new(path: Path, payload: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as stream:
        stream.write(payload)


def _bbox(block: dict[str, object]) -> tuple[int, int, int, int]:
    raw = block["bbox"]
    if not isinstance(raw, list) or len(raw) != 4:
        raise ValueError("Surya block lacks a four-coordinate bbox")
    return tuple(round(float(value)) for value in raw)  # type: ignore[return-value]


def _semantic_type(kind: str) -> str:
    return {"function": "definition", "section": "section", "body": "prose", "code": "code"}[
        kind
    ]


def _collapse_editorial_newlines(value: str) -> str:
    """Turn recovered editor line breaks into reflowable paragraph spacing.

    Bolio physical lines are source-editor convenience, not evidence of where
    the printed compositor broke a prose line. Code is handled separately.
    """

    normalized = value.replace("\r\n", "\n").replace("\r", "\n")
    return " ".join(normalized.split("\n"))


def _merge_runs(runs: Sequence[InlineRun]) -> tuple[InlineRun, ...]:
    merged: list[InlineRun] = []
    for run in runs:
        if not run.text:
            continue
        if merged and merged[-1].style == run.style:
            if merged[-1].evidence == run.evidence:
                merged[-1] = InlineRun(
                    merged[-1].text + run.text, run.style, run.evidence
                )
            else:
                merged.append(run)
        else:
            merged.append(run)
    return tuple(merged)


def _inline_runs_from_bolio(
    raw_lines: Sequence[str], variables: Mapping[str, str], fallback: str
) -> tuple[InlineRun, ...]:
    """Recover the small inline font vocabulary used by this source slice.

    Numbered ``^F`` controls push a selector and ``^F*`` pops it. The selector
    identity is retained instead of being collapsed into a guessed font trait.
    Unexpected or unbalanced controls fail closed rather than silently losing
    formatting evidence.
    """

    runs: list[InlineRun] = []
    style = "body"
    evidence = "source-default-font-1"
    font_stack: list[tuple[str, str]] = []
    bold = False
    for line_number, source_line in enumerate(raw_lines):
        if line_number:
            runs.append(InlineRun(" ", style, evidence))
        index = 0
        while index < len(source_line):
            character = source_line[index]
            if character == "\x06":
                if index + 1 >= len(source_line):
                    raise ValueError("truncated Bolio font control")
                selector = source_line[index + 1]
                if selector == "*":
                    if not font_stack:
                        raise ValueError("Bolio font pop has no matching push")
                    style, evidence = font_stack.pop()
                else:
                    role = _ROLE_BY_SELECTOR.get(selector)
                    if role is None:
                        raise ValueError(f"unsupported Bolio font selector {selector!r}")
                    font_stack.append((style, evidence))
                    style = role
                    evidence = f"source-control-font-{selector}"
                index += 2
                continue
            if character == "\x11":
                if index + 1 >= len(source_line):
                    raise ValueError("truncated Bolio quoted-character control")
                runs.append(InlineRun(source_line[index + 1], style, evidence))
                index += 2
                continue
            if (
                character == "\x16"
                and index + 1 < len(source_line)
                and source_line[index + 1] == "("
            ):
                closing = source_line.find(")", index + 2)
                if closing == -1:
                    raise ValueError("unterminated Bolio variable reference")
                name = source_line[index + 2 : closing].upper()
                replacement = variables.get(name)
                if replacement is None:
                    raise ValueError(f"undefined Bolio variable {name!r}")
                runs.append(InlineRun(replacement, style, evidence))
                index = closing + 1
                continue
            if character == "\x19":
                bold = True
                index += 1
                continue
            if character == "\x18":
                bold = False
                index += 1
                continue
            if bold:
                raise ValueError("unresolved Bolio explicit-bold control in pilot source")
            runs.append(InlineRun(character, style, evidence))
            index += 1
    if font_stack:
        raise ValueError("Bolio font push is not closed by ^F*")
    rendered = _merge_runs(runs)
    rendered_text = _collapse_editorial_newlines("".join(run.text for run in rendered))
    expected_text = _collapse_editorial_newlines(fallback)
    if rendered_text != expected_text:
        raise ValueError("Bolio styled spans do not align with canonical source text")
    # Editorial newlines become one space; literal intra-line spacing remains.
    normalized: list[InlineRun] = []
    for run in rendered:
        text = _collapse_editorial_newlines(run.text)
        normalized.append(InlineRun(text, run.style, run.evidence))
    return _merge_runs(normalized)


def semantic_runs(
    *,
    kind: str,
    reference_text: str,
    raw_lines: Sequence[str],
    variables: Mapping[str, str],
) -> tuple[InlineRun, ...]:
    """Return print-intent runs without promoting source editor newlines."""

    if kind == "function":
        match = re.fullmatch(r"(\S+)(.*)", reference_text, flags=re.DOTALL)
        if match is None:
            raise ValueError("function heading must contain a function name")
        runs = (InlineRun(match.group(1), "definition-name", "directive-.defun-first-atom"),) + tuple(
            InlineRun(argument, "definition-argument", "directive-.defun-remaining-atoms")
            for argument in re.findall(r"\s+\S+", match.group(2), flags=re.DOTALL)
        )
    elif kind == "code":
        # Preserve nested selector evidence (for example ^F2 around `sym`) but
        # let the structural no-fill environment determine physical appearance.
        runs = (
            _inline_runs_from_bolio(raw_lines, variables, reference_text)
            if raw_lines
            else (InlineRun(reference_text, "display-code", "directive-.lisp"),)
        )
    elif kind == "section":
        runs = (InlineRun(reference_text, "section-title", "directive-.section"),)
    else:
        runs = _inline_runs_from_bolio(raw_lines, variables, reference_text)
    expected = reference_text if kind == "code" else _collapse_editorial_newlines(reference_text)
    if "".join(run.text for run in runs) != expected:
        raise ValueError("semantic runs must concatenate to the source-derived rendered text")
    return runs


def _physical_style(style: str, kind: str) -> tuple[str, str, int]:
    if kind == "code":
        return MONO_FONT, "normal", 400
    elif style == "font-3-inline-lisp":
        return SANS_FONT, "normal", 400
    elif style in {"font-2-italic", "definition-argument"}:
        return SERIF_FONT, "italic", 400
    elif style == "definition-name":
        return SANS_FONT, "normal", 700
    elif style == "section-title":
        return SERIF_FONT, "normal", 700
    return SERIF_FONT, "normal", 400


def _pango_markup(kind: str, runs: Sequence[InlineRun]) -> str:
    parts: list[str] = []
    for run in runs:
        family, slant, weight = _physical_style(run.style, kind)
        parts.append(
            f'<span font_family="{html.escape(family)}" style="{slant}" '
            f'weight="{weight}">{html.escape(run.text)}</span>'
        )
    return "".join(parts)


def _native_layout(
    *, kind: str, runs: Sequence[InlineRun], width: float, size: float, indent: float
) -> tuple[str, dict[str, object]]:
    with tempfile.TemporaryDirectory(prefix="lispmdoc-pango-") as temporary:
        temporary_path = Path(temporary)
        source = temporary_path / "region.pango"
        svg = temporary_path / "region.svg"
        serialized = temporary_path / "layout.json"
        source.write_text(_pango_markup(kind, runs), encoding="utf-8")
        command = [
            "pango-view",
            "--no-display",
            "--pixels",
            "--markup",
            "--background=transparent",
            "--foreground=#17201d",
            f"--font={SERIF_FONT} {size}",
            f"--width={round(width)}",
            "--wrap=word-char",
            f"--indent={round(indent)}",
            f"--line-spacing={_LINE_HEIGHT[kind]}",
            "--margin=0",
            f"--output={svg}",
            f"--serialize-to={serialized}",
            str(source),
        ]
        subprocess.run(command, check=True, capture_output=True)
        svg_text = svg.read_text(encoding="utf-8")
        root_match = re.search(r"<svg\b[^>]*>(.*)</svg>\s*$", svg_text, flags=re.DOTALL)
        if root_match is None:
            raise ValueError("Pango did not emit an SVG document")
        return root_match.group(1), json.loads(serialized.read_text(encoding="utf-8"))


def layout_region(
    *,
    kind: str,
    runs: Sequence[InlineRun],
    bbox: tuple[int, int, int, int],
    paragraph_indent: bool,
) -> RegionLayout:
    """Fit semantic runs into scan-derived geometry at readable page scale."""

    x1, y1, x2, y2 = bbox
    base_size = _BASE_FONT_SIZE[kind]
    max_height = y2 - y1
    # A first-line indent is a print-layout property. Source paragraphs after a
    # section begin at the page margin; definition explanations already have a
    # scan-measured block indent and therefore do not receive a second one.
    indent = 100.0 if paragraph_indent else 0.0
    size = base_size
    svg_inner: str | None = None
    shaped: dict[str, object] | None = None
    for _ in range(24):
        optical_inset = size * _OPTICAL_LEFT_INSET_FACTOR
        candidate_svg, candidate = _native_layout(
            kind=kind,
            runs=runs,
            width=x2 - x1 - optical_inset,
            size=size,
            indent=indent,
        )
        output = candidate["output"]
        if not isinstance(output, dict):
            raise ValueError("Pango serialization lacks output metrics")
        width_fits = kind != "code" or not bool(output["is-wrapped"])
        line_height = size * _LINE_HEIGHT[kind]
        logical_height = float(output["height"]) / 1024
        if width_fits and logical_height <= max_height:
            svg_inner, shaped = candidate_svg, candidate
            break
        if size <= 34.0:
            raise ValueError("native shaped layout does not fit its scan-derived region")
        size -= 1.0
    if svg_inner is None or shaped is None:
        raise ValueError("could not fit a non-empty semantic run into its review region")
    line_height = size * _LINE_HEIGHT[kind]
    origin_x = x1 + size * _OPTICAL_LEFT_INSET_FACTOR
    origin_y = float(y1)
    shaped_output = shaped["output"]
    assert isinstance(shaped_output, dict)
    used_width = float(shaped_output["width"]) / 1024
    used_height = float(shaped_output["height"]) / 1024
    generated = (
        origin_x,
        origin_y,
        origin_x + used_width,
        origin_y + used_height,
    )
    if generated[2] > x2 + 0.01 or generated[3] > y2 + 0.01:
        raise ValueError("native ink extents exceed the scan-derived region")
    return RegionLayout(
        svg_inner,
        (origin_x, origin_y),
        size,
        line_height,
        len(shaped_output["lines"]),
        generated,
        tuple(runs),
        tuple(
            run["font"]
            for line in shaped_output["lines"]
            for run in line["runs"]
            if isinstance(run, dict) and isinstance(run.get("font"), dict)
        ),
    )


def _svg(layouts: Sequence[RegionLayout]) -> bytes:
    content = [
        '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" '
        f'width="{PAGE_WIDTH}" height="{PAGE_HEIGHT}" viewBox="0 0 {PAGE_WIDTH} {PAGE_HEIGHT}">',
        f'<rect width="{PAGE_WIDTH}" height="{PAGE_HEIGHT}" fill="#fffdf8"/>',
    ]
    for index, layout in enumerate(layouts):
        prefix = f"region-{index}-"
        inner = re.sub(r'id="([^"]+)"', rf'id="{prefix}\1"', layout.svg_inner)
        inner = re.sub(r'(?:xlink:href|href)="#([^"]+)"', rf'xlink:href="#{prefix}\1"', inner)
        inner = re.sub(r'url\(#([^)]+)\)', rf'url(#{prefix}\1)', inner)
        content.append(
            f'<g transform="translate({layout.origin[0]:.3f} {layout.origin[1]:.3f})">'
            f"{inner}</g>"
        )
    content.append("</svg>")
    return ("\n".join(content) + "\n").encode("utf-8")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--project-root", type=Path, default=Path.cwd())
    parser.add_argument(
        "--output", type=Path, default=Path("work/benchmark-pilot/authoritative-review-r8")
    )
    args = parser.parse_args()
    root = args.project_root.resolve()
    output = (root / args.output).resolve() if not args.output.is_absolute() else args.output
    if output.exists():
        raise FileExistsError(f"refusing to overwrite pilot output: {output}")

    recovered = root / "source-material/reference-transcriptions/unlambda"
    archive = recovered / "lmman.tar.gz"
    lmman = recovered / "extracted/lmman"
    source = lmman / "orig4ed/fd_sym.70"
    variables = lmman / "orig4ed/manual.vars"
    scan = next((root / "work/benchmark-pilot" / SOURCE_PDF_SHA256).glob("*/pages/p000100.png"))
    surya = root / "work/benchmark-pilot/surya/p000100/results.json"
    old_queue = json.loads((root / "work/benchmark-pilot/queue-pilot.json").read_text())

    expected = {
        archive: ARCHIVE_SHA256,
        source: SOURCE_SHA256,
        variables: VARS_SHA256,
        scan: RENDER_SHA256,
    }
    for path, digest in expected.items():
        if _sha256(path) != digest:
            raise ValueError(f"pilot input digest changed: {path}")

    source_text = source.read_text(encoding="latin-1")
    variables_text = variables.read_text(encoding="latin-1")
    extraction = extract_bolio(
        source_text,
        variables_text,
        start_line=126,
        end_line=180,
    )
    if extraction.issues:
        raise ValueError("Bolio extraction has unresolved issues")
    reference = render_reference_artifact(extraction)
    source_lines = source_text.splitlines()
    source_variables = parse_manual_vars(variables_text)

    raw_surya = json.loads(surya.read_text(encoding="utf-8"))
    blocks = raw_surya["p000100"][0]["blocks"]
    content_blocks = [block for block in blocks if 3 <= int(block["reading_order"]) <= 17]
    if len(content_blocks) != len(reference.regions):
        raise ValueError("source blocks no longer align one-to-one with Surya content blocks")

    reference_runs = []
    for reference_region in reference.regions:
        raw_lines = source_lines[
            reference_region.bolio_start_line - 1 : reference_region.bolio_end_line
        ]
        reference_runs.append(
            semantic_runs(
                kind=reference_region.kind,
                reference_text=reference_region.text,
                raw_lines=raw_lines,
                variables=source_variables,
            )
        )

    converter_files = [
        root / "src/lispmdoc/benchmark/bolio.py",
        root / "src/lispmdoc/benchmark/source_reference.py",
        root / "scripts/prepare-chinual-authoritative-pilot",
    ]
    font_identities = [_font_identity(family) for family in (SERIF_FONT, SANS_FONT, MONO_FONT)]
    converter_manifest = _json_bytes(
        {
            "format_version": "lispmdoc-bolio-reference-converter-2",
            "implementation_files": [
                {"path": path.relative_to(root).as_posix(), "sha256": _sha256(path)}
                for path in converter_files
            ],
            "native_layout": {
                "font_assets": font_identities,
                "pango_version": _tool_version(("pango-view", "--version")),
                "renderer": "one-pango-layout-per-region-to-cairo-svg-outlines",
            },
            "physical_style_mapping": {
                "body": {"family": SERIF_FONT, "evidence": "scan-matched-substitute"},
                "definition-argument": {
                    "family": SERIF_FONT,
                    "slant": "italic",
                    "evidence": "typesetter-guide-explicit",
                },
                "definition-name": {
                    "family": SANS_FONT,
                    "weight": 700,
                    "evidence": "typesetter-guide-explicit-role; family-substitute",
                },
                "display-code": {
                    "family": MONO_FONT,
                    "evidence": "typesetter-guide-fixed-width; family-substitute",
                },
                "font-2-italic": {
                    "family": SERIF_FONT,
                    "slant": "italic",
                    "evidence": "source-selector-2-and-typesetter-guide",
                },
                "font-3-inline-lisp": {
                    "family": SANS_FONT,
                    "weight": 400,
                    "evidence": "r7-human-scan-classification; exact-artifact-unresolved",
                },
            },
            "regions": [
                {
                    "bolio_source_span": [
                        region.bolio_start_line,
                        region.bolio_end_line,
                    ],
                    "index": region.index,
                    "kind": region.kind,
                    "line_break_policy": region.line_break_policy,
                    "semantic_spans": _span_records(runs),
                }
                for region, runs in zip(reference.regions, reference_runs, strict=True)
            ],
            "source_line_span": [126, 180],
        }
    )
    converter_sha256 = hashlib.sha256(converter_manifest).hexdigest()

    prior_page = old_queue["pages"][0]
    region_ids = tuple(f"block-{index:03d}" for index in range(1, len(reference.regions) + 1))
    queue_page = QueuePage(
        SOURCE_PDF_SHA256,
        99,
        RENDER_SHA256,
        str(prior_page["page_class"]),
        tuple(prior_page["tags"]),
        region_ids,
        expected_run_from_dict(prior_page["expected_run"]),
    )
    truth_regions: list[AuthoritativeRegionTruth] = []
    review_regions: list[dict[str, object]] = []
    layouts: list[RegionLayout] = []
    for region_id, reference_region, runs, surya_block in zip(
        region_ids, reference.regions, reference_runs, content_blocks, strict=True
    ):
        x1, y1, x2, y2 = _bbox(surya_block)
        semantic = _semantic_type(reference_region.kind)
        breaks = tuple(
            index for index, character in enumerate(reference_region.text) if character == "\n"
        )
        truth_regions.append(
            AuthoritativeRegionTruth(
                RegionGeometry(
                    region_id,
                    ((x1, y1), (x2, y1), (x2, y2), (x1, y2)),
                    ((x1, y2), (x2, y2)),
                    reference_region.index,
                    semantic,
                ),
                reference_region.text,
                breaks,
                reference_region.kind,
                SourceSpan(
                    reference_region.source_span.start_line,
                    reference_region.source_span.end_line,
                ),
                layout_verification_state="human-review-required",
            )
        )
        paragraph_indent = semantic == "prose" and x1 <= round(PAGE_WIDTH * 0.13)
        layout = layout_region(
            kind=reference_region.kind,
            runs=runs,
            bbox=(x1, y1, x2, y2),
            paragraph_indent=paragraph_indent,
        )
        layouts.append(layout)
        normalized_reference_box = [
            x1 / PAGE_WIDTH,
            y1 / PAGE_HEIGHT,
            (x2 - x1) / PAGE_WIDTH,
            (y2 - y1) / PAGE_HEIGHT,
        ]
        generated_x1, generated_y1, generated_x2, generated_y2 = layout.generated_bbox
        normalized_generated_box = [
            generated_x1 / PAGE_WIDTH,
            generated_y1 / PAGE_HEIGHT,
            (generated_x2 - generated_x1) / PAGE_WIDTH,
            (generated_y2 - generated_y1) / PAGE_HEIGHT,
        ]
        review_regions.append(
            {
                "canonical_text": reference_region.text,
                "id": region_id,
                "kind": semantic,
                "label": reference_region.text.splitlines()[0][:80],
                "ocr_text": _html_text(str(surya_block["html"])),
                "reference_box": normalized_reference_box,
                "generated_box": normalized_generated_box,
                "source_text": reference_region.text,
            }
        )

    furniture_specs = (
        ("running-header-section", "The Property List", _bbox(blocks[0])),
        ("running-header-page", "88", _bbox(blocks[1])),
        ("running-header-title", "Lisp Machine Manual", _bbox(blocks[2])),
        ("running-footer-source", "MCL:LMMAN;FD.SYM 70", _bbox(blocks[18])),
        ("running-footer-date", "24-JUL-81", _bbox(blocks[19])),
    )
    furniture_records: list[dict[str, object]] = []
    for furniture_id, text, bbox in furniture_specs:
        furniture_layout = layout_region(
            kind="body",
            runs=(InlineRun(text, "body", "scan-derived-human-verified-running-matter"),),
            bbox=bbox,
            paragraph_indent=False,
        )
        layouts.append(furniture_layout)
        furniture_records.append(
            {
                "generated_bbox": list(furniture_layout.generated_bbox),
                "id": furniture_id,
                "provenance": "scan-derived-human-verified-running-matter",
                "reference_bbox": list(bbox),
                "text": text,
            }
        )

    package = AuthoritativeTruthPackage(
        AUTHORITATIVE_TRUTH_VERSION,
        queue_page,
        QueuePageBinding.from_queue_page(queue_page),
        TypesetterSourceProvenance(
            ARCHIVE_SHA256,
            SOURCE_SHA256,
            "Lisp Machine Manual, fourth edition, July 1981",
            "lmman/orig4ed/fd_sym.70",
            ("strip-final-newline",),
            TextDerivation(
                "converted-text",
                "utf-8",
                "lispmdoc-bolio-reference-converter-2",
                converter_sha256,
                reference.sha256,
            ),
            (SupportingSourceFile("lmman/orig4ed/manual.vars", VARS_SHA256),),
        ),
        MappingEvidence(
            (
                MappingAnchor("printed-page-number", "88", "88"),
                MappingAnchor("heading", "The Property List", "The Property List"),
                MappingAnchor(
                    "source-footer", "MCL:LMMAN;FD.SYM 70", "MCL:LMMAN;FD.SYM 70"
                ),
            ),
            "human-mapping-review-required",
        ),
        tuple(truth_regions),
    )

    assets = output / "assets"
    assets.mkdir(parents=True)
    scan_copy = assets / "scan-p000100.png"
    shutil.copyfile(scan, scan_copy)
    replica = assets / "source-layout-p000100.svg"
    _write_new(replica, _svg(layouts))
    _write_new(output / "reference.txt", reference.bytes)
    _write_new(output / "converter-manifest.json", converter_manifest)
    _write_new(output / "truth-package.json", package.to_json().encode("utf-8"))
    _write_new(
        output / "queue.json",
        _json_bytes({"pages": [queue_page.to_dict()], "version": "lispmdoc-benchmark-wave1"}),
    )
    review_project = {
        "assets": {
            "replica-p000100": {
                "media_type": "image/svg+xml",
                "path": "assets/source-layout-p000100.svg",
                "sha256": _sha256(replica),
            },
            "scan-p000100": {
                "media_type": "image/png",
                "path": "assets/scan-p000100.png",
                "sha256": _sha256(scan_copy),
            },
        },
        "document_id": "chinual-4th-edition-page-100",
        "format_version": "1.0",
        "pages": [
            {
                "generated_asset_id": "replica-p000100",
                "id": queue_page.id,
                "label": "PDF page 100 · printed page 88 · FD.SYM 70",
                "reference_asset_id": "scan-p000100",
                "regions": review_regions,
            }
        ],
        "review_instructions": {
            "page": (
                "Accept only if the scan is printed page 88 and its footer identifies "
                "MCL:LMMAN;FD.SYM 70, and if the three running headers and two footer "
                "items are all present in the replica. This confirms mapping and running matter."
            ),
            "region": (
                "Accept only if wording, source-scoped typeface, paragraph reflow/indent, and "
                "the highlighted scan region agree. The same spelling may have different styles "
                "in different source contexts. Check that mixed-style words have ordinary spacing "
                "with neither gaps nor overlap. Use needs fix for any mismatch."
            ),
        },
        "running_matter": furniture_records,
        "title": "Chinual 4th edition · authoritative-source pilot",
    }
    _write_new(output / "review-project.json", _json_bytes(review_project))
    prior_annotations = (
        root / "work/benchmark-pilot/authoritative-review-r7/review-project.annotations.json"
    )
    prior_project = root / "work/benchmark-pilot/authoritative-review-r7/review-project.json"
    if prior_annotations.is_file() and prior_project.is_file():
        _write_new(
            output / "prior-review-feedback.json",
            _json_bytes(
                {
                    "annotations": json.loads(prior_annotations.read_text(encoding="utf-8")),
                    "prior_review_project_sha256": _sha256(prior_project),
                    "prior_review_revision": "r7",
                    "status": "retained-separately; do-not-apply-to-new-revision",
                }
            ),
        )
    _write_new(
        output / "material-paths.json",
        _json_bytes(
            {
                "converted_text": "reference.txt",
                "converter": "converter-manifest.json",
                "source_archive": str(archive),
                "source_file": str(source),
                "supporting": {"lmman/orig4ed/manual.vars": str(variables)},
            }
        ),
    )
    print(output / "review-project.json")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
